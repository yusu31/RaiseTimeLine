{
  "name": "raisetimeline-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test scenarios/ --project=chromium",
    "test:all": "playwright test scenarios/ --project=chromium --project=firefox --project=webkit",
    "test:slow": "cross-env E2E_INCLUDE_SLOW=1 playwright test scenarios/ --project=chromium --grep @slow",
    "test:perf": "playwright test performance/ --project=chromium --workers=1",
    "test:a11y": "playwright test accessibility/ --project=chromium",
    "test:headed": "playwright test scenarios/ --project=chromium --headed",
    "test:debug": "playwright test scenarios/ --project=chromium --debug",
    "seed": "docker exec -i raisetimeline-postgres psql -U raisetime -d raisetimeline_e2e < data/seed-e2e-data.sql",
    "cleanup": "docker exec -i raisetimeline-postgres psql -U raisetime -d raisetimeline_e2e < data/cleanup-e2e-data.sql",
    "seed:ci": "cross-env PGPASSWORD=password psql -h localhost -p 5432 -U raisetime -d raisetimeline_e2e -f data/seed-e2e-data.sql",
    "report": "playwright show-report results/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.0"
  }
}
