{
  "name": "raisetimeline-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:perf": "playwright test performance/ --project=chromium",
    "test:a11y": "playwright test accessibility/ --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "seed": "docker exec -i raisetimeline-postgres psql -U raisetime -d raisetimeline_e2e < data/seed-e2e-data.sql",
    "cleanup": "docker exec -i raisetimeline-postgres psql -U raisetime -d raisetimeline_e2e < data/cleanup-e2e-data.sql",
    "report": "playwright show-report results/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0"
  }
}
